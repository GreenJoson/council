# 可选 mock（本地视觉原型）或 http（真实 Council REST/SSE）。
VITE_COUNCIL_DATA_MODE=mock

# 仅 http 模式需要；填写 Council API origin，不要把地址写进源码。
VITE_COUNCIL_API_URL=

# 仅 http 模式需要；填写当前项目的绝对路径，用于为 Agent 提供可信工作目录。
VITE_COUNCIL_PROJECT_PATH=/path/to/your-project

# Topic 列表分页大小与当前议题最近消息读取数量。
VITE_COUNCIL_TOPIC_PAGE_SIZE=100
VITE_COUNCIL_MESSAGE_PAGE_SIZE=100

# SSE revision 对应的 REST 校准失败时，有界重试次数与基础退避间隔。
VITE_COUNCIL_EVENT_REFRESH_MAX_ATTEMPTS=3
VITE_COUNCIL_EVENT_REFRESH_RETRY_DELAY_MS=1000
VITE_COUNCIL_EVENT_RECOVERY_DELAY_MS=10000

# 自动轮次独立分页与 SSE 校准失败后的恢复间隔。
VITE_COUNCIL_ORCHESTRATION_PAGE_SIZE=50
VITE_COUNCIL_ORCHESTRATION_RECOVERY_DELAY_MS=10000
