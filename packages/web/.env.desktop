VITE_COUNCIL_DATA_MODE=desktop
VITE_COUNCIL_TOPIC_PAGE_SIZE=100
VITE_COUNCIL_MESSAGE_PAGE_SIZE=100
VITE_COUNCIL_EVENT_RECOVERY_DELAY_MS=1000

# 自动轮次直连本地 Agent 服务的分页与 SSE 校准参数（地址由 Rust 设置层提供，不在此配置）。
VITE_COUNCIL_ORCHESTRATION_PAGE_SIZE=50
VITE_COUNCIL_EVENT_REFRESH_MAX_ATTEMPTS=3
VITE_COUNCIL_EVENT_REFRESH_RETRY_DELAY_MS=1000
VITE_COUNCIL_ORCHESTRATION_RECOVERY_DELAY_MS=10000

# 本地 Agent 服务离线时的健康探测重试间隔；服务启动后据此自动转 LIVE。
VITE_COUNCIL_DESKTOP_HEALTH_INTERVAL_MS=4000
