COUNCIL_DATA_DIR=/path/to/local-data
# 显式任务委派的隔离 Git worktree 根目录；留空时使用 COUNCIL_DATA_DIR 下的受控子目录
COUNCIL_DELEGATION_WORKTREE_ROOT=
# 仅 stdio MCP 入口必填；Codex 使用 codex，Claude 使用 claude，复制后必须显式选择
COUNCIL_CALLER_ACTOR_ALIAS=<caller-actor-alias>
COUNCIL_CLAUDE_COMMAND=claude
COUNCIL_CLAUDE_ARGS_JSON=[]
COUNCIL_CLAUDE_MODEL=
COUNCIL_CLAUDE_PERMISSION_MODE=plan
# Claude CLI 自身的绝对时长上限（毫秒）；编排器另有活动感知超时
COUNCIL_CLAUDE_TIMEOUT_MS=3600000
COUNCIL_CLAUDE_KILL_GRACE_MS=3000
# 普通讨论/实施指令回合数；编程与审核使用独立有界预算
COUNCIL_CLAUDE_EXECUTION_MAX_TURNS=120
COUNCIL_CLAUDE_REVIEW_MAX_TURNS=48
COUNCIL_CLAUDE_MAX_TURNS=8
# Codex CLI 可执行程序；未设置时默认 codex，可写绝对路径
COUNCIL_CODEX_COMMAND=codex
# 追加给 Codex 的额外参数（JSON 字符串数组）；沙箱、审批与子命令等保留参数会被拒绝
COUNCIL_CODEX_ARGS_JSON=[]
# Codex 使用的模型；留空走 CLI 默认模型
COUNCIL_CODEX_MODEL=
# Codex 沙箱模式；只允许 read-only（只读执行，禁止写盘和越权命令）
COUNCIL_CODEX_SANDBOX_MODE=read-only
# Codex CLI 自身的绝对时长上限（毫秒）；编排器另有活动感知超时
COUNCIL_CODEX_TIMEOUT_MS=3600000
# Codex 终止宽限期（毫秒），SIGTERM→SIGKILL 逐级升级的等待间隔；未设置时默认 3000
COUNCIL_CODEX_KILL_GRACE_MS=3000
# Codex 生图：仅当 Runtime 探针确认 image_generate 可用（features 稳定启用、未覆盖 model_provider）时生效
COUNCIL_CODEX_IMAGE_ENABLED=true
# 生图独立沙箱；只允许 workspace-write，讨论沙箱仍固定 read-only
COUNCIL_CODEX_IMAGE_SANDBOX_MODE=workspace-write
# 单次生图调用的绝对时长上限（毫秒）
COUNCIL_CODEX_IMAGE_TIMEOUT_MS=900000
# 单次图像委派最多入库张数
COUNCIL_CODEX_IMAGE_MAX_OUTPUTS=16
# Codex 数据目录，图像委派兜底收集 generated_images/<threadId>/；留空依次回退 CODEX_HOME 与 ~/.codex
COUNCIL_CODEX_HOME=

# ACP 委托运行时通用边界；各 Agent 复用本机登录，不使用 Council API Key
COUNCIL_KIMI_ACP_COMMAND=kimi
COUNCIL_GEMINI_ACP_COMMAND=gemini
COUNCIL_GROK_ACP_COMMAND=grok
COUNCIL_CODEX_ACP_COMMAND=codex-acp
COUNCIL_CLAUDE_ACP_COMMAND=claude-agent-acp
COUNCIL_ACP_STARTUP_TIMEOUT_MS=30000
COUNCIL_ACP_KILL_GRACE_MS=3000
COUNCIL_ACP_MAX_FILE_READ_CHARS=262144
# 兼容 API 的 Council 只读 ToolLoop；MAX_OUTPUT 同时作为单批工具共享预算，写操作始终禁用
COUNCIL_TOOL_LOOP_MAX_STEPS=12
COUNCIL_TOOL_LOOP_MAX_CONTEXT_CHARS=120000
COUNCIL_TOOL_LOOP_MAX_FILE_BYTES=1048576
COUNCIL_TOOL_LOOP_MAX_SCAN_FILES=5000
# 受控 Git diff：仅允许已提交 ref，不执行 shell、pager、textconv 或 ext-diff
COUNCIL_GIT_COMMAND=git
COUNCIL_GIT_DIFF_TIMEOUT_MS=15000
COUNCIL_GIT_DIFF_KILL_GRACE_MS=1000
COUNCIL_GIT_DIFF_MAX_FILES=200
COUNCIL_GIT_DIFF_MAX_LINES=4000
COUNCIL_GIT_DIFF_MAX_HUNKS_PER_FILE=200
COUNCIL_GIT_DIFF_MAX_OUTPUT_CHARS=30000
# 实际代码委派/草稿恢复的完整 Git 内容检查预算，与只读 diff 展示预算独立
COUNCIL_DELEGATION_GIT_MAX_OUTPUT_CHARS=1000000
# macOS Keychain 命令；留空时远程 Provider 的 API Key 保存功能不可用
COUNCIL_KEYCHAIN_COMMAND=security
COUNCIL_SQLITE_BUSY_TIMEOUT_MS=5000
# 必填；桌面 sidecar 由打包资源显式注入
COUNCIL_SCHEMA_MIGRATION_MAX_ATTEMPTS=3
COUNCIL_MAX_CONTEXT_CHARS=60000
# 最终回复/交付摘要长度；不决定 CLI 执行过程的事件流额度
COUNCIL_MAX_OUTPUT_CHARS=30000
# Claude/Codex CLI 累计事件流额度（含读文件、工具结果等）；只滚动保留输出窗口
COUNCIL_CLI_MAX_STREAM_CHARS=32000000
COUNCIL_DEFAULT_MESSAGE_LIMIT=100
COUNCIL_HTTP_HOST=127.0.0.1
COUNCIL_HTTP_PORT=4317
# stdio MCP 转发任务委派到上面 HTTP 服务的超时（毫秒）；MCP 进程未设置 COUNCIL_HTTP_* 时回落 127.0.0.1:4317
COUNCIL_MCP_HTTP_TIMEOUT_MS=10000
# CORS 白名单；桌面（Tauri macOS 生产构建）接入需追加 "tauri://localhost"
COUNCIL_HTTP_CORS_ORIGINS_JSON=["http://localhost:5173","tauri://localhost"]
COUNCIL_HTTP_CORS_MAX_AGE_SECONDS=600
COUNCIL_HTTP_RATE_LIMIT_WINDOW_MS=60000
COUNCIL_HTTP_RATE_LIMIT_MAX=120
COUNCIL_HTTP_BODY_LIMIT_BYTES=65536
COUNCIL_HTTP_EVENT_POLL_MS=500
COUNCIL_HTTP_EVENT_RETRY_MS=3000
COUNCIL_HTTP_EVENT_HEARTBEAT_MS=15000
COUNCIL_HTTP_SHUTDOWN_TIMEOUT_MS=5000
COUNCIL_ORCHESTRATION_LEASE_TTL_MS=30000
COUNCIL_ORCHESTRATION_LEASE_RENEW_MS=10000
COUNCIL_ORCHESTRATION_SWEEP_INTERVAL_MS=5000
COUNCIL_ORCHESTRATION_DEFAULT_MAX_ROUNDS=8
COUNCIL_ORCHESTRATION_DEFAULT_MAX_ATTEMPTS=2
COUNCIL_ORCHESTRATION_DEFAULT_MAX_RECOVERIES=2
# 连续没有协议、工具或文本活动时中止；任何合法 Runtime 活动都会刷新
COUNCIL_ORCHESTRATION_DEFAULT_AGENT_IDLE_TIMEOUT_MS=300000
# 单次调用绝对时长上限；不会被活动刷新，防止失控进程长期占用资源
COUNCIL_ORCHESTRATION_DEFAULT_AGENT_TIMEOUT_MS=3600000
COUNCIL_ORCHESTRATION_AGENT_CLEANUP_TIMEOUT_MS=3000
# 默认自动完成；需要人工复核时可在单次调用中显式开启
COUNCIL_ORCHESTRATION_CONFIRM_COMPLETION=false
COUNCIL_ORCHESTRATION_RUN_PAGE_LIMIT=50
COUNCIL_ORCHESTRATION_STARTUP_SCAN_LIMIT=1000
COUNCIL_ORCHESTRATION_SHUTDOWN_TIMEOUT_MS=5000
# 同一议题 Agent 持久会话的空闲关闭时间（毫秒）
COUNCIL_RUNTIME_BINDING_IDLE_TIMEOUT_MS=1800000

# 仅只读指令/审核的瞬态错误可自动重试；写入失败需要检查后恢复
COUNCIL_DELEGATION_RETRY_DELAY_MS=1500
# 后台服务无请求、无活动任务时退出；有任务时退出桌面不会中断执行。
COUNCIL_WORKER_HEARTBEAT_MS=5000
COUNCIL_WORKER_IDLE_TIMEOUT_MS=300000
# 一次委派内所有执行/修正段的累计上限；1 表示关闭自动接续。
COUNCIL_DELEGATION_MAX_EXECUTION_SEGMENTS=4
COUNCIL_DELEGATION_EXECUTION_TIMEOUT_MS=7200000
# P3 设计流水线：模板阶段数上限（超过则拒绝创建）与 Lead 复盘后自动修订轮数上限（达到即转人工选定，最多 31）。
COUNCIL_PIPELINE_MAX_STAGES=6
COUNCIL_PIPELINE_MAX_REVISIONS=3
# 原型代码委派请求的权限档：workspace_write 在沙箱内改代码（通常起不了服务与浏览器，做不了的验证留给人工），
# danger_full_access 让 Codex 不带沙箱运行以便自行起服务验证——执行 Agent 的权限档也得是该档，只建议在隔离机器上开。
COUNCIL_PIPELINE_PROTOTYPE_PERMISSION=workspace_write
# P4 Worker 团队：单个团队同时运行的 Worker 上限（1–16），创建团队时冻结；超过上限的派发返回 409。
COUNCIL_WORKER_MAX_PARALLEL=3
# 项目文件只读预览预算；表格解析在独立 Worker 中进行
COUNCIL_FILE_PREVIEW_MAX_BYTES=10000000
COUNCIL_FILE_PREVIEW_MAX_TEXT_CHARS=200000
COUNCIL_FILE_PREVIEW_MAX_ROWS=500
COUNCIL_FILE_PREVIEW_MAX_COLUMNS=80
COUNCIL_FILE_PREVIEW_MAX_SHEETS=30
COUNCIL_FILE_PREVIEW_MAX_CELL_CHARS=1000
COUNCIL_FILE_PREVIEW_MAX_EXPANDED_BYTES=50000000
COUNCIL_FILE_PREVIEW_MAX_ARCHIVE_ENTRIES=10000
COUNCIL_FILE_PREVIEW_WORKER_MEMORY_MB=256
COUNCIL_FILE_PREVIEW_TIMEOUT_MS=15000

# 资产库（v19）：根目录留空时为 COUNCIL_DATA_DIR 下的 assets 子目录；配额按未删除资产的字节数求和
COUNCIL_ASSET_DIR=
COUNCIL_ASSET_MAX_BYTES=26214400
COUNCIL_ASSET_MAX_TOTAL_BYTES=5368709120
# 入库按文件头嗅探 MIME，不信扩展名；只能取 png/jpeg/webp/gif/svg+xml/gltf-binary/pdf 的子集
COUNCIL_ASSET_MIME_ALLOWLIST=image/png,image/jpeg,image/webp,image/svg+xml,model/gltf-binary,application/pdf
# 缩略图由外部命令生成（macOS 自带 sips），超时即放弃并返回 404
COUNCIL_ASSET_THUMBNAIL_MAX_EDGE=512
COUNCIL_ASSET_THUMBNAIL_COMMAND=sips
COUNCIL_ASSET_THUMBNAIL_TIMEOUT_MS=10000
