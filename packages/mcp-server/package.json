{
  "name": "council-mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server for shared Claude and Codex architecture discussions",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "prebuild": "npm run build --prefix ../orchestrator",
    "build": "tsc",
    "precheck": "npm run build --prefix ../orchestrator",
    "check": "tsc --noEmit",
    "dev:http": "node --env-file-if-exists=.env --import tsx src/http-index.ts",
    "start": "node dist/src/index.js",
    "start:http": "node --env-file-if-exists=.env dist/src/http-index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "council-orchestrator": "file:../orchestrator",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "4.1.1"
  }
}
